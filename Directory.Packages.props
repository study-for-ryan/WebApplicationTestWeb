<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <!-- ⚠️ 安全实验室专用: 以下 NuGet 版本是"已知含漏洞"的旧版本, 专门用于测试 Dependabot 告警。
         每个包都有对应的 GHSA 安全公告, 推送到 GitHub 后 Dependabot 会生成告警。
         同时 dotnet build 时 NuGetAudit 也会直接给出 NU19xx 警告。生产项目切勿复制这些版本! -->
    <PackageVersion Include="HtmlAgilityPack" Version="1.13.1" />
    <PackageVersion Include="Microsoft.Data.SqlClient" Version="2.1.4" />
    <!-- Newtonsoft.Json < 13.0.2 存在漏洞 (GHSA-5crp-9r3c-p9vr), 修复版本 13.0.2+ -->
    <PackageVersion Include="Newtonsoft.Json" Version="12.0.3" />
    <!-- RestSharp <= 110.1.0 存在信息泄露漏洞, 修复版本 110.2.0+ -->
    <PackageVersion Include="RestSharp" Version="106.12.0" />
    <!-- SixLabors.ImageSharp 2.x 存在多个漏洞, 修复版本 3.1.11+ -->
    <PackageVersion Include="SixLabors.ImageSharp" Version="2.1.2" />
  </ItemGroup>
</Project>
